# generated by kon

font=Sans 10
background-color=#{{frame}}eb
text-color=#{{text}}
width=520
padding=10
border-size={{border_width}}
border-color=#{{accent}}
border-radius={{radius}}
progress-color=over #{{accent}}4d
margin=9,9,0,9
default-timeout=6000
format=%s\n<span color="#{{dim}}">%b</span>

[urgency=low]
border-color=#{{dim}}

# critical ones stay until dismissed
[urgency=critical]
border-color=#{{urgent}}
text-color=#{{urgent}}
default-timeout=0
