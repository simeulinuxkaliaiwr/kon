# generated by kon

# made by kon-lock
image={{cache}}/aro/lock.png
scaling=fill
color={{background}}

font=Sans
# pango's 10pt is 13px at scale 1
font-size=13

indicator-idle-visible
indicator-thickness=9

# idle
ring-color={{dim}}ff
inside-color={{frame}}ff
text-color={{dim}}ff

# typing
key-hl-color={{accent}}ff
bs-hl-color={{text}}ff
caps-lock-key-hl-color={{accent}}ff
caps-lock-bs-hl-color={{text}}ff

# checking
ring-ver-color={{accent}}ff
inside-ver-color={{frame_focus}}ff
text-ver-color={{accent}}ff

# wrong
ring-wrong-color={{urgent}}ff
inside-wrong-color={{frame}}ff
text-wrong-color={{urgent}}ff

# cleared
ring-clear-color={{text}}ff
inside-clear-color={{frame}}ff
text-clear-color={{text}}ff

# caps lock
ring-caps-lock-color={{dim}}ff
inside-caps-lock-color={{frame}}ff
text-caps-lock-color={{urgent}}ff

# no inner line or separators
line-uses-inside
separator-color=00000000

layout-bg-color={{frame}}ff
layout-border-color={{dim}}ff
layout-text-color={{text}}ff
