// generated by kon
layout {
    gaps {{gaps}}
    // let the wallpaper show through
    background-color "transparent"
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
    border {
        on
        width {{border_width}}
        active-color "#{{accent}}"
        inactive-color "#{{border}}"
    }
    shadow {
        on
        softness 24
        color "#1b263355"
    }
}

overview {
    backdrop-color "#{{background}}"
}

window-rule {
    geometry-corner-radius {{radius}}
    clip-to-geometry true
}
