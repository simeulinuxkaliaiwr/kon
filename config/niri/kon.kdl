// generated by kon
layout {
    gaps 8
    // let the wallpaper show through
    background-color "transparent"
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
    border {
        on
        width 2
        active-color "#3a8ee6"
        inactive-color "#8ea6c0"
    }
    shadow {
        on
        softness 24
        color "#1b263355"
    }
}

overview {
    backdrop-color "#eef3f8"
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}
